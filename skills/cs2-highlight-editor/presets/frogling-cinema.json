{
  "_sobre": "frogling versão cinema + zuhn: cortes no beat, grade quente e lavada, flash branco nos cortes, legendas de comentário e replay em slow-mo com letterbox no kill decisivo, bloom no impacto.",
  "music": {
    "start": "drop",
    "volume": 0.9,
    "fadeOut": 1.2
  },
  "pacing": {
    "beatSync": true,
    "preRoll": 1,
    "postRoll": 0.5,
    "maxGap": 2.2
  },
  "audio": {
    "gameVolume": 0.55
  },
  "color": {
    "contrast": 1.15,
    "saturation": 0.75,
    "warmth": 0.15,
    "tealOrange": 0.12,
    "vignette": true
  },
  "motionBlur": 3,
  "effects": {
    "slowmo": {
      "on": "last",
      "speed": 0.35,
      "before": 0.2,
      "after": 0.5,
      "interpolate": "blend",
      "letterbox": true,
      "rampOut": {
        "speed": 1.6,
        "duration": 0.3
      }
    },
    "zoom": {
      "on": "all",
      "amount": 0.06,
      "duration": 0.3
    },
    "shake": {
      "on": "last",
      "px": 8,
      "duration": 0.2
    },
    "flash": {
      "on": "none",
      "opacity": 0.5,
      "duration": 0.07
    },
    "bloom": {
      "on": "last",
      "amount": 0.3,
      "duration": 0.3
    }
  },
  "transitions": {
    "type": "cut",
    "flashOnCut": true
  },
  "text": {
    "killCounter": false,
    "labels": true,
    "labelDuration": 1.4,
    "size": 0.1,
    "position": "center",
    "captionSize": 0.048
  },
  "output": {
    "fadeIn": 0.5,
    "fadeOut": 1,
    "formats": [
      "16x9",
      "9x16"
    ],
    "vertical": "crop"
  }
}