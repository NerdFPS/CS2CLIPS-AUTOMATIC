{
  "_sobre": "Velocity edit estilo frogling (30 vídeos analisados em 2026-11): ~19 cortes/min, ~17 flashes/min, saturação baixa, speed ramp (slow no kill + aceleração), motion blur forte, transições whip/zoom/flash/radial alternadas, grade azul-petróleo/laranja, quase sem texto. Bom para vídeos curtos (≤1 min) de 4K/ACE.",
  "music": {
    "start": "drop",
    "volume": 1,
    "fadeOut": 1.2
  },
  "pacing": {
    "beatSync": true,
    "preRoll": 0.75,
    "minPreRoll": 0.35,
    "postRoll": 0.35,
    "maxGap": 1.6
  },
  "audio": {
    "gameVolume": 0.45
  },
  "color": {
    "contrast": 1.2,
    "saturation": 0.62,
    "tealOrange": 0.25,
    "sharpen": 0.5,
    "vignette": true
  },
  "motionBlur": 4,
  "effects": {
    "slowmo": {
      "on": "all",
      "speed": 0.5,
      "before": 0.08,
      "after": 0.2,
      "interpolate": "blend",
      "rampOut": {
        "speed": 1.8,
        "duration": 0.35
      }
    },
    "zoom": {
      "on": "all",
      "amount": 0.1,
      "duration": 0.3
    },
    "shake": {
      "on": "all",
      "px": 10,
      "duration": 0.22
    },
    "flash": {
      "on": "all",
      "opacity": 0.4,
      "duration": 0.06
    },
    "rgbsplit": {
      "on": "none"
    },
    "bloom": {
      "on": "last",
      "amount": 0.35,
      "duration": 0.3
    }
  },
  "transitions": {
    "type": [
      "zoomin",
      "hblur",
      "fadewhite",
      "radial"
    ],
    "duration": 0.15
  },
  "text": {
    "killCounter": false,
    "labels": true,
    "labelDuration": 1.3,
    "size": 0.12,
    "position": "center",
    "color": "#FFFFFF",
    "border": "#000000",
    "borderW": 5
  },
  "output": {
    "fadeIn": 0.6,
    "fadeOut": 0.8,
    "formats": [
      "16x9",
      "9x16"
    ],
    "vertical": "crop"
  }
}